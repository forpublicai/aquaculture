# Copy this file to .env and fill in real values. .env is gitignored.

# Required: OpenRouter API key (https://openrouter.ai/settings/keys)
# Requests are routed through OpenRouter rather than calling Anthropic
# directly, but the model itself stays Claude Opus 5.
OPENROUTER_API_KEY=

# Optional overrides — see src/config.py for defaults.
# OpenRouter's slug for the model used in conversational intake/routing and
# RAG Q&A. Verify the exact slug at https://openrouter.ai/models before
# deploying — OpenRouter's naming can differ slightly from Anthropic's own
# model IDs.
OPENROUTER_MODEL=anthropic/claude-opus-5

# Optional: sent as attribution headers on OpenRouter requests (used for
# https://openrouter.ai/rankings). Safe to leave blank for local dev.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Maine Aquaculture License Assistant

# Local path where the Chroma vector store persists between runs.
VECTOR_STORE_DIR=data/vector_store

# Local path where source regulatory/application documents are read from
# for ingestion into the knowledge base (Phase 3).
KNOWLEDGE_BASE_DIR=data/knowledge_base
