# Copy to .env.local and fill in real values. .env.local is gitignored.

# --- OpenRouter (chat completions AND embeddings — same key, same gateway) ---
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5
# Verify current slugs at https://openrouter.ai/models before deploying.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Attribution headers for https://openrouter.ai/rankings — safe to leave blank.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME="Public AI Aquaculture"

# --- Supabase (conversation state + pgvector regulatory document store) ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# Service role key — server-side only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only for one-off schema migrations (psql),
# not by the app at runtime. Project Settings -> Database -> Connection string
# (use the non-pooling / session-mode URL for DDL).
POSTGRES_URL_NON_POOLING=
