{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/arrows/**",
              "components/brand/**",
              "components/buttons/**",
              "components/navigation/**",
              "ui_kits/inference-utility/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:NB International Pro CG|NB International Pro Mono|Public Sans|Inter|Overpass|Overpass Mono|Roboto Flex))/i]",
        "message": "Font not provided by the design system. Available: NB International Pro CG, NB International Pro Mono, Public Sans, Inter, Overpass, Overpass Mono, Roboto Flex."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLeft'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLeft> doesn't accept that prop. Declared props: onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowRight'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArrowRight> doesn't accept that prop. Declared props: onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonLinkout'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ButtonLinkout> doesn't accept that prop. Declared props: children, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|mark|network|inference-utility)$/]",
        "message": "<Logo> variant must be one of 'default' | 'mark' | 'network' | 'inference-utility'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<LogoMark> doesn't accept that prop. Declared props: height, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navigation'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|buttonLabel|breakpoint|onButtonClick|style|key|ref|className|style|children)$/]",
        "message": "<Navigation> doesn't accept that prop. Declared props: title, buttonLabel, breakpoint, onButtonClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navigation'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:desktop|tablet)$/]",
        "message": "<Navigation> breakpoint must be one of 'desktop' | 'tablet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavigationMobile'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|buttonLabel|open|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<NavigationMobile> doesn't accept that prop. Declared props: title, items, buttonLabel, open, onNavigate, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ArrowLeft": {
        "replaces": []
      },
      "ArrowRight": {
        "replaces": []
      },
      "Button": {
